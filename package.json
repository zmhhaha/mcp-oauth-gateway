{
  "name": "mcp-oauth-gateway",
  "version": "0.2.0",
  "description": "OAuth 2.1 for MCP clients that only know how to send a static Authorization header: a loopback gateway that does RFC 9728 discovery, PKCE and silent refresh on their behalf.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmhhaha/mcp-oauth-gateway.git"
  },
  "homepage": "https://github.com/zmhhaha/mcp-oauth-gateway#readme",
  "bugs": {
    "url": "https://github.com/zmhhaha/mcp-oauth-gateway/issues"
  },
  "bin": {
    "mcp-oauth-gateway": "bin/mcp-oauth-gateway.mjs"
  },
  "main": "./src/oauth.mjs",
  "exports": {
    ".": "./src/oauth.mjs",
    "./gateway": "./src/gateway.mjs",
    "./store": "./src/store.mjs",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "dsh",
    "docs",
    "locale",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "start": "node ./bin/mcp-oauth-gateway.mjs"
  },
  "meta": {
    "title": "MCP OAuth Gateway",
    "description": "Runs a loopback gateway an MCP client can point at without any OAuth support: the gateway performs RFC 9728 discovery, PKCE and silent token refresh, and the client keeps a stable local token that is not the OAuth credential."
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "oauth2",
    "oauth21",
    "pkce",
    "rfc9728",
    "rfc8707",
    "rfc8414",
    "dsh",
    "proxy",
    "gateway"
  ]
}
